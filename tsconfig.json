{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,
    "types": ["node"],
    "baseUrl": ".",
    "paths": {
      "@tutor/shared": ["packages/shared/src/index.ts"],
      "@tutor/content-ingest": ["packages/content-ingest/src/index.ts"],
      "@tutor/ai-core": ["packages/ai-core/src/index.ts"],
      "@tutor/pedagogy": ["packages/pedagogy/src/index.ts"],
      "@tutor/resource-service": ["packages/resource-service/src/index.ts"],
      "@tutor/export": ["packages/export/src/index.ts"],
      "@tutor/practice": ["packages/practice/src/index.ts"],
      "@tutor/study": ["packages/study/src/index.ts"],
      "@renderer/*": ["apps/desktop/src/renderer/*"]
    }
  },
  "include": [
    "packages/**/*.ts",
    "apps/desktop/src/main/**/*.ts",
    "apps/desktop/src/preload/**/*.ts",
    "apps/mobile/src/**/*.ts"
  ]
}
